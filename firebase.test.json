{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "firestore": {
      "port": 8180
    },
    "functions": {
      "port": 5101
    },
    "hosting": {
      "port": 5150
    },
    "hub": {
      "port": 4600
    },
    "logging": {
      "port": 4700
    },
    "eventarc": {
      "port": 9399
    },
    "tasks": {
      "port": 9599
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
