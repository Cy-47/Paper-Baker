rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global, deduplicated paper metadata cache. Readable by any signed-in user,
    // but writable ONLY by the backend (the papers function, via the Admin SDK,
    // which bypasses these rules). Clients must never write here: it is shared
    // across all users, so a client write is a cache-poisoning vector. The web
    // app never needs to — it renders from its own users/{uid}/savedPapers copy
    // and resolves uncached papers through the backend.
    match /papers/{paperId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Device-link login codes are managed exclusively by the backend (Admin
    // SDK, which bypasses rules). No client may read or write them — the secret
    // device code and the bound uid must never be client-accessible.
    match /deviceCodes/{deviceCode} {
      allow read, write: if false;
    }

    // Backend-only secret material for connected CLIs: the SHA-256 of each
    // access token plus the uid it resolves to (keyed by connectionId). Locked
    // off entirely — the hash must never be client-readable, and only the
    // device-link flow (Admin SDK) may write it. The user-facing, client-managed
    // half lives under users/{uid}/clis below.
    match /cliSessions/{connectionId} {
      allow read, write: if false;
    }

    // Backend-only rate-limiter state (the global arXiv request-slot clock). Held
    // and advanced exclusively by the Functions backend (Admin SDK); no client
    // may read or write it.
    match /rateLimits/{name} {
      allow read, write: if false;
    }

    // Per-user data — read-your-own, WRITE BACKEND-ONLY. The web reads these via
    // real-time snapshots but performs every mutation through the Functions API
    // (Admin SDK, which bypasses these rules), exactly like the CLI. Making the
    // backend the sole writer means there is one implementation of the domain
    // rules (slug minting, projectPaper ⊆ savedPapers, terminal revoke, …) and no
    // way for a client to write an inconsistent or forged document.

    // A user's saved papers (the "Library"): thin { paperId, savedAt } records;
    // metadata lives in the global papers/ cache.
    match /users/{userId}/savedPapers/{paperId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Connected CLIs, surfaced in the web "CLI" tab (display metadata + revocation
    // status; the token hash lives backend-only in cliSessions above). Deletes go
    // through the device API.
    match /users/{userId}/clis/{connectionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Append-only CLI activity log shown below the connection list. The backend
    // appends a connect/delete entry per event; the owner reads their own.
    match /users/{userId}/cliEvents/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Projects are scoped under their owner: users/{uid}/projects/{id}.
    match /users/{userId}/projects/{projectId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // projectPapers: the papers filed into this project — the single source of
      // truth for the project<->paper link. ownerUid is stamped by the backend so
      // the cross-project collectionGroup read below can authorize on it.
      match /projectPapers/{paperId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Cross-project membership reads. collectionGroup("projectPapers") matches by
    // collection id at any depth, so it can't bind {userId} from the path — it is
    // authorized on the doc's ownerUid instead, and the query MUST filter
    // where("ownerUid", "==", uid) (rules validate, they don't filter).
    match /{path=**}/projectPapers/{paperId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }
  }
}
